<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Werewolf Experience - Escena de Terror</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  
  <!-- Cargamos A-Frame para la escena 3D -->
  <script src="https://aframe.io/releases/1.4.2/aframe.min.js"></script>
  <!-- Cargamos el componente de extras para reproducir las animaciones de los GLB -->
  <script src="https://cdn.jsdelivr.net/gh/donmccurdy/aframe-extras@v6.1.1/dist/aframe-extras.min.js"></script>
  
  <style>
    /* Botón flotante para regresar a la consola de control */
    .btn-back-hud {
      position: fixed;
      top: 20px;
      left: 20px;
      z-index: 9999;
      font-family: monospace;
    }
    .btn-back-hud a {
      background: rgba(0, 0, 0, 0.85);
      color: #ff5500;
      border: 2px solid #ff5500;
      padding: 10px 16px;
      text-decoration: none;
      font-weight: bold;
      border-radius: 6px;
      box-shadow: 0 0 15px rgba(255, 85, 0, 0.4);
      font-size: 0.8rem;
      letter-spacing: 1px;
      transition: all 0.2s ease;
      display: inline-block;
    }
    .btn-back-hud a:hover {
      background: #ff5500;
      color: #000000;
      box-shadow: 0 0 25px rgba(255, 85, 0, 0.8);
    }
  </style>
</head>
<body>

  <!-- Botón de escape al panel de telemetría -->
  <div class="btn-back-hud">
    <a href="inter.html">⤶ VOLVER AL DASHBOARD</a>
  </div>

  <!-- ⚡ AQUÍ ESTÁ EL TRUCO: Añadido "gltf-model" con la ruta al decodificador de Draco -->
  <a-scene 
    fog="type: exponential; color: #0b0d1a; density: 0.04;"
    gltf-model="dracoDecoderPath: https://www.gstatic.com/draco/v1/decoders/;">
    
    <!-- 1. GESTIÓN DE ASSETS (Carga optimizada de tus GLB desde Hugging Face) -->
    <a-assets timeout="15000">
      <a-asset-item id="pueblo" src="https://huggingface.co/datasets/Luis-Fernando/werewolf/resolve/main/pueblo.glb"></a-asset-item>
      <a-asset-item id="casa" src="https://huggingface.co/datasets/Luis-Fernando/werewolf/resolve/main/casa.glb"></a-asset-item>
      
      <!-- Hombres Lobo -->
      <a-asset-item id="werewolf-beast" src="https://huggingface.co/datasets/Luis-Fernando/werewolf/resolve/main/Werewolf_Beast.glb"></a-asset-item>
      <a-asset-item id="werewolf-howl" src="https://huggingface.co/datasets/Luis-Fernando/werewolf/resolve/main/Werewolf_Howl.glb"></a-asset-item>
      <a-asset-item id="werewolf-idle" src="https://huggingface.co/datasets/Luis-Fernando/werewolf/resolve/main/Werewolf_Idle.glb"></a-asset-item>
      
      <!-- Avatares de Luis -->
      <a-asset-item id="luis-camina" src="https://huggingface.co/datasets/Luis-Fernando/werewolf/resolve/main/luis-camina.glb"></a-asset-item>
      <a-asset-item id="luis-llama" src="https://huggingface.co/datasets/Luis-Fernando/werewolf/resolve/main/luis-llama.glb"></a-asset-item>
      <a-asset-item id="luis-sigilo" src="https://huggingface.co/datasets/Luis-Fernando/werewolf/resolve/main/luis-sigilo.glb"></a-asset-item>
    </a-assets>

    <!-- 2. ILUMINACIÓN (Luz de luna tenue y una luz focal misteriosa) -->
    <a-light type="ambient" color="#1a2035" intensity="0.3"></a-light>
    <a-light type="directional" color="#9ab2e1" intensity="0.5" position="-5 10 -5" castShadow="true"></a-light>

    <!-- 3. CIELO NOCTURNO -->
    <a-sky color="#05070f"></a-sky>

    <!-- 4. ENTORNO (Pueblo y Casa) -->
    <a-entity gltf-model="#pueblo" position="0 0 0" scale="1 1 1" shadow="receive: true"></a-entity>
    <a-entity gltf-model="#casa" position="-8 0 -12" rotation="0 45 0" scale="1.2 1.2 1.2"></a-entity>

    <!-- 5. PERSONAJES Y ANIMACIONES -->
    <a-entity gltf-model="#werewolf-idle" 
              position="3 0 -6" 
              rotation="0 -45 0" 
              scale="1.5 1.5 1.5"
              animation-mixer>
    </a-entity>

    <a-entity gltf-model="#werewolf-howl" 
              position="10 2.5 -15" 
              rotation="0 -90 0" 
              scale="1.5 1.5 1.5"
              animation-mixer>
    </a-entity>

    <a-entity gltf-model="#luis-sigilo" 
              position="-2 0 -5" 
              rotation="0 30 0" 
              scale="1 1 1"
              animation-mixer>
    </a-entity>

    <a-entity gltf-model="#luis-llama" 
              position="-6 0 -10" 
              rotation="0 120 0" 
              scale="1 1 1"
              animation-mixer>
    </a-entity>

    <!-- 6. CÁMARA DE USUARIO -->
    <a-entity id="rig" position="0 1.6 2">
      <a-camera look-controls wasd-controls="fly: false; acceleration: 20;"></a-camera>
    </a-entity>

  </a-scene>
</body>
</html>
